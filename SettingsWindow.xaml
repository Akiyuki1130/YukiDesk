<Window x:Class="DesktopBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:DesktopBar.UI"
        Title="YukiDesk 设置" Width="1000" Height="700"
        FontFamily="{x:Static ui:Ui.TextFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="False" ShowInTaskbar="True"
        PreviewKeyDown="Settings_PreviewKeyDown"
        ResizeMode="CanResize" MinWidth="760" MinHeight="530">
    <Window.Resources>
        <DataTemplate x:Key="DesktopTargetRow">
            <StackPanel ToolTip="{Binding Detail}">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontWeight="Medium"/>
                <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="11"
                           Foreground="{DynamicResource SettingsSubTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            <Setter Property="StrokeThickness" Value="1.35"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Margin" Value="0,0,11,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingsChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsControlBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorder}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="55"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Padding="{TemplateBinding Padding}" CornerRadius="18"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SettingsHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SettingsSelected}"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource SettingsSelectedBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SettingsAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource SettingsLabelBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <Border Background="{DynamicResource SettingsDivider}" Height="1" Margin="0,0,0,4"/>
                            <ToggleButton Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Foreground="{TemplateBinding Foreground}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Header" Background="Transparent" CornerRadius="18"
                                                BorderBrush="Transparent" BorderThickness="1" Padding="12,0" MinHeight="36">
                                            <DockPanel>
                                                <Path x:Name="Chevron" DockPanel.Dock="Right" Data="M 1,2 L 5,6 L 9,2"
                                                      Stroke="{DynamicResource SettingsSubTextBrush}" StrokeThickness="1.3"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Header" Property="Background" Value="{DynamicResource SettingsHoverBackground}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Header" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="47" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="16"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowRoot" CornerRadius="16"
            Background="{DynamicResource SettingsWindowBackground}"
            BorderBrush="{DynamicResource SettingsWindowBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="47"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0"
                    Background="Transparent"
                    MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                <Grid>
                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource SettingsDivider}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <ContentControl x:Name="TitleIconHost" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock Text="YukiDesk 设置" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource SettingsTextBrush}"
                                   Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Style="{StaticResource WindowCaptionButton}" Content="&#xE921;"
                                AutomationProperties.Name="最小化" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="最小化" Click="Minimize_Click"/>
                        <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;"
                                AutomationProperties.Name="关闭" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="关闭" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavigationColumn" Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource SettingsSidebarBackground}" CornerRadius="0,0,0,15"
                        BorderBrush="{DynamicResource SettingsDivider}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="14,19,14,10">
                                <TextBox x:Name="SettingsSearchBox" Style="{StaticResource DarkBox}" Height="38" Padding="32,0,34,0"
                                         TextChanged="Search_TextChanged" AutomationProperties.Name="搜索设置项"
                                         ToolTip="搜索设置项（Ctrl+F）"/>
                                <Path Data="M 6,1 A 5,5 0 1 1 5.99,1 Z M 10,10 L 14,14"
                                      Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.25"
                                      Stroke="{DynamicResource SettingsSubTextBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="SearchPlaceholder" Text="搜索设置"
                                           Foreground="{DynamicResource SettingsSubTextBrush}"
                                           Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Button x:Name="ClearSettingsSearch" Style="{StaticResource WindowCaptionButton}"
                                        Content="&#xE8BB;" AutomationProperties.Name="清空搜索" ToolTip="清空搜索（Esc）" Click="ClearSearch_Click"
                                        Height="26" Width="26" Margin="0,0,4,0" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="14,0,14,11">
                            <ScrollViewer x:Name="NavigationScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="NavigationItems" VerticalAlignment="Top">
                                <RadioButton Style="{StaticResource NavRadio}" GroupName="SettingsPages" IsChecked="True"
                                             AutomationProperties.Name="外观" Checked="Nav_Checked" Tag="Appearance">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M 8,1.5 C 4.4,1.5 1.5,4 1.5,7.7 C 1.5,11.6 4,14.4 7.3,14.4 C 8.6,14.4 8.6,13.4 8.1,12.5 C 7.5,11.4 8.1,10.5 9.4,10.5 L 11.4,10.5 C 13.5,10.5 14.6,9.1 14.6,7.4 C 14.6,4.2 11.9,1.5 8,1.5 Z M 4.4,7 L 4.5,7 M 6.6,4.9 L 6.7,4.9 M 9.6,4.9 L 9.7,4.9 M 11.7,7 L 11.8,7"/>
                                        <TextBlock Text="外观" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavRadio}" GroupName="SettingsPages"
                                             AutomationProperties.Name="时间" Checked="Nav_Checked" Tag="Time">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M 8,1.5 A 6.5,6.5 0 1 1 7.99,1.5 Z M 8,4.4 L 8,8 L 10.8,9.4"/>
                                        <TextBlock Text="时间" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavRadio}" GroupName="SettingsPages"
                                             AutomationProperties.Name="小文件夹" Checked="Nav_Checked" Tag="Folders">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M 1.4,5 L 1.4,4 C 1.4,3.2 2,2.8 2.8,2.8 L 5.5,2.8 L 7.1,4.6 L 13.2,4.6 C 14.1,4.6 14.6,5.1 14.6,6 L 14.6,11.8 C 14.6,12.7 14,13.2 13.2,13.2 L 2.8,13.2 C 2,13.2 1.4,12.7 1.4,11.8 Z"/>
                                        <TextBlock Text="小文件夹" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavRadio}" GroupName="SettingsPages"
                                             AutomationProperties.Name="顶栏布局" Checked="Nav_Checked" Tag="Modules">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M 2,2 L 6.5,2 L 6.5,6.5 L 2,6.5 Z M 9.5,2 L 14,2 L 14,6.5 L 9.5,6.5 Z M 2,9.5 L 6.5,9.5 L 6.5,14 L 2,14 Z M 9.5,9.5 L 14,9.5 L 14,14 L 9.5,14 Z"/>
                                        <TextBlock Text="顶栏布局" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavRadio}" GroupName="SettingsPages"
                                             AutomationProperties.Name="通用" Checked="Nav_Checked" Tag="General">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M 2,4 L 6,4 M 9,4 L 14,4 M 2,8 L 8,8 M 11,8 L 14,8 M 2,12 L 4,12 M 7,12 L 14,12 M 6,2.8 L 9,2.8 L 9,5.2 L 6,5.2 Z M 8,6.8 L 11,6.8 L 11,9.2 L 8,9.2 Z M 4,10.8 L 7,10.8 L 7,13.2 L 4,13.2 Z"/>
                                        <TextBlock Text="通用" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavRadio}" GroupName="SettingsPages"
                                             AutomationProperties.Name="关于" Checked="Nav_Checked" Tag="About">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M 8,1.5 A 6.5,6.5 0 1 1 7.99,1.5 Z M 8,7.1 L 8,11.2 M 8,4.7 L 8,4.8"/>
                                        <TextBlock Text="关于" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                            </ScrollViewer>
                            <ListBox x:Name="SettingsSearchResults" Style="{StaticResource DarkList}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="设置搜索结果"
                                     PreviewMouseLeftButtonUp="SearchResult_MouseUp" Visibility="Collapsed">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel.ToolTip>
                                                <StackPanel MaxWidth="280">
                                                    <TextBlock Text="{Binding Label, Mode=OneTime}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Context, Mode=OneTime}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel.ToolTip>
                                            <TextBlock Text="{Binding Label, Mode=OneTime}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SettingsTextBrush}"/>
                                            <TextBlock Text="{Binding Context, Mode=OneTime}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SettingsSubTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="SearchEmpty" Text="没有匹配的设置项"
                                       Foreground="{DynamicResource SettingsSubTextBrush}"
                                       Margin="12,8,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="16,0,16,17">
                            <Border Height="1" Background="{DynamicResource SettingsDivider}" Margin="0,0,0,12"/>
                            <TextBlock Text="设置主题" Foreground="{DynamicResource SettingsSubTextBrush}" FontSize="12.5" Margin="1,0,0,7"/>
                            <ContentControl x:Name="SettingsThemeHost" HorizontalContentAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PageTitle" Text="外观" FontSize="24" FontWeight="Medium"
                               Margin="27,20,27,16" Foreground="{DynamicResource SettingsTextBrush}"/>
                    <Grid x:Name="PagesGrid" Grid.Row="1" ClipToBounds="True">
                        <ScrollViewer Tag="Appearance" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="AppearanceHost" Margin="27,0,27,24"/>
                        </ScrollViewer>
                        <ScrollViewer Tag="Time" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <StackPanel x:Name="TimeHost" Margin="27,0,27,24"/>
                        </ScrollViewer>
                        <ScrollViewer Tag="Folders" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <StackPanel x:Name="FoldersHost" Margin="27,0,27,24"/>
                        </ScrollViewer>
                        <ScrollViewer Tag="Modules" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <StackPanel x:Name="ModulesHost" Margin="27,0,27,24"/>
                        </ScrollViewer>
                        <ScrollViewer Tag="General" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <StackPanel x:Name="GeneralHost" Margin="27,0,27,24"/>
                        </ScrollViewer>
                        <ScrollViewer Tag="About" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <StackPanel x:Name="AboutHost" Margin="27,0,27,24"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
